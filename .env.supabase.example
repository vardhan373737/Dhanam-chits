SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_with_supabase_service_role_key
SESSION_SECRET=replace_with_session_secret
SUPABASE_PORT=5000
SMTP_USER=replace_with_smtp_user
SMTP_PASS=replace_with_smtp_pass

# Cashfree Payment Gateway
CASHFREE_ENV=sandbox
CASHFREE_APP_ID=replace_with_cashfree_app_id
CASHFREE_SECRET_KEY=replace_with_cashfree_secret_key
CASHFREE_WEBHOOK_SECRET=replace_with_cashfree_webhook_secret

# Optional callback/webhook URLs
# CASHFREE_RETURN_URL=https://your-domain.com/chitpayment.html?order_id={order_id}
# CASHFREE_NOTIFY_URL=https://your-domain.com/api/cashfree/webhook
