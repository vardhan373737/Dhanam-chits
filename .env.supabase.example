SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_with_supabase_service_role_key
SESSION_SECRET=replace_with_session_secret
SUPABASE_PORT=5000
SMTP_USER=replace_with_smtp_user
SMTP_PASS=replace_with_smtp_pass

# WhatsApp delivery
# Use WHATSAPP_PROVIDER=meta or twilio for a single provider.
# Use WHATSAPP_PROVIDER_ORDER=meta,twilio to try Meta first and Twilio as fallback.
WHATSAPP_PROVIDER=auto
WHATSAPP_PROVIDER_ORDER=meta,twilio
WHATSAPP_META_PHONE_NUMBER_ID=replace_with_meta_phone_number_id
WHATSAPP_META_ACCESS_TOKEN=replace_with_meta_access_token
TWILIO_ACCOUNT_SID=replace_with_twilio_account_sid
TWILIO_AUTH_TOKEN=replace_with_twilio_auth_token
TWILIO_WHATSAPP_FROM=replace_with_twilio_whatsapp_number
# Optional Twilio Content Template SIDs (used when scheduling template-type reminders)
TWILIO_CONTENT_SID_STANDARD=
TWILIO_CONTENT_SID_URGENT=
TWILIO_CONTENT_SID_APPOINTMENT=
TWILIO_CONTENT_SID_ORDER=
TWILIO_CONTENT_SID_VERIFICATION=
TWILIO_CONTENT_SID_DEFAULT=

# Cashfree Payment Gateway
CASHFREE_ENV=sandbox
CASHFREE_APP_ID=replace_with_cashfree_app_id
CASHFREE_SECRET_KEY=replace_with_cashfree_secret_key
CASHFREE_WEBHOOK_SECRET=replace_with_cashfree_webhook_secret

# Optional callback/webhook URLs
# CASHFREE_RETURN_URL=https://your-domain.com/chitpayment.html?order_id={order_id}
# CASHFREE_NOTIFY_URL=https://your-domain.com/api/cashfree/webhook
